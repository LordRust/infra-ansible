# Managed by Ansible

storage:
  dbPath: /var/lib/mongodb

systemLog:
  destination: file
  logAppend: true
  path: /var/log/mongodb/mongod.log

net:
  port: {{ mongodb_port }}
  bindIp: "{{ mongodb_bind_addresses | join(',') }}"

processManagement:
  timeZoneInfo: /usr/share/zoneinfo

security:
  authorization: {{ mongodb_authorization }}
